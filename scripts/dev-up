#!/usr/bin/env bash
# Start the local dev dependencies (compose project navigator-dev: Postgres + Garage).
# First run generates .dev/navigator.env with random local-only credentials.
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
ENVF="$ROOT/.dev/navigator.env"
COMPOSE=(docker compose -p navigator-dev -f "$ROOT/deploy/dev/compose.yaml" --env-file "$ENVF")
DB_PORT=5450 S3_PORT=9450 APP_PORT=8930

hex() { od -An -N"$1" -tx1 /dev/urandom | tr -d ' \n'; }

if [[ ! -f "$ENVF" ]]; then
  mkdir -p "$ROOT/.dev"
  owner_pw=$(hex 18) app_pw=$(hex 18)
  (umask 077; cat >"$ENVF" <<EOF
# Local development only. Generated by scripts/dev-up; never commit (.dev/ is gitignored).
NAVIGATOR_ENV=dev
NAVIGATOR_PUBLIC_URL=http://localhost:5173
NAVIGATOR_DEV_DB_PORT=$DB_PORT
NAVIGATOR_DEV_S3_PORT=$S3_PORT

POSTGRES_PASSWORD=$(hex 18)
NAVIGATOR_DB_OWNER_PASSWORD=$owner_pw
NAVIGATOR_DB_APP_PASSWORD=$app_pw
NAVIGATOR_DATABASE_URL=postgresql+psycopg://navigator_app:$app_pw@127.0.0.1:$DB_PORT/navigator
NAVIGATOR_MIGRATE_DATABASE_URL=postgresql+psycopg://navigator_owner:$owner_pw@127.0.0.1:$DB_PORT/navigator

GARAGE_RPC_SECRET=$(hex 32)
GARAGE_ADMIN_TOKEN=$(hex 32)
NAVIGATOR_S3_ENDPOINT=http://127.0.0.1:$S3_PORT
NAVIGATOR_S3_REGION=garage
NAVIGATOR_S3_BUCKET=navigator-media
NAVIGATOR_S3_ACCESS_KEY_ID=GK$(hex 12)
NAVIGATOR_S3_SECRET_ACCESS_KEY=$(hex 32)

# WorkOS *staging* environment (needed from M1). Paste from the WorkOS dashboard.
WORKOS_API_KEY=
WORKOS_CLIENT_ID=
EOF
  )
  echo "created $ENVF"
fi

# refuse to start if something other than our own containers holds the ports
for port in $DB_PORT $S3_PORT; do
  if ss -ltnH "sport = :$port" | grep -q . && ! docker ps --format '{{.Names}} {{.Ports}}' | grep -E "^navigator-dev-.*:$port->" -q; then
    echo "port $port is in use by something else; free it or change NAVIGATOR_DEV_*_PORT in $ENVF" >&2
    exit 1
  fi
done

"${COMPOSE[@]}" up -d --wait db
"${COMPOSE[@]}" up -d storage

set -a; source "$ENVF"; set +a
"$ROOT/scripts/garage-init" navigator-dev-storage

echo "navigator-dev is up: postgres 127.0.0.1:$DB_PORT · garage s3 127.0.0.1:$S3_PORT"
echo "next: scripts/dev-backend (API on :$APP_PORT) and cd frontend && pnpm dev"
