#!/usr/bin/env bash
# Run the backend checks against the navigator-dev stack (lint, types, tests).
set -euo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
set -a; source "$ROOT/.dev/navigator.env"; set +a
cd "$ROOT/backend"
uv run ruff check .
uv run ruff format --check .
uv run mypy
uv run pytest "$@"
