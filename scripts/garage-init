#!/usr/bin/env bash
# Idempotently prepare a single-node Garage: layout, the app's access key, the bucket.
# Usage: scripts/garage-init <container>   (reads NAVIGATOR_S3_* from the environment)
set -euo pipefail
CONTAINER="${1:?usage: garage-init <container>}"
: "${NAVIGATOR_S3_ACCESS_KEY_ID:?}" "${NAVIGATOR_S3_SECRET_ACCESS_KEY:?}" "${NAVIGATOR_S3_BUCKET:?}"
garage() { docker exec -e RUST_LOG=warn "$CONTAINER" /garage "$@"; }

for _ in $(seq 30); do garage status >/dev/null 2>&1 && break; sleep 1; done
garage status >/dev/null

if garage layout show 2>/dev/null | grep -q "No nodes currently have a role"; then
  node=$(garage node id -q | cut -d@ -f1)
  garage layout assign -z local -c "${GARAGE_CAPACITY:-2G}" "$node" >/dev/null
  garage layout apply --version 1 >/dev/null
fi
garage key info "$NAVIGATOR_S3_ACCESS_KEY_ID" >/dev/null 2>&1 \
  || garage key import --yes -n navigator "$NAVIGATOR_S3_ACCESS_KEY_ID" "$NAVIGATOR_S3_SECRET_ACCESS_KEY" >/dev/null
garage bucket info "$NAVIGATOR_S3_BUCKET" >/dev/null 2>&1 || garage bucket create "$NAVIGATOR_S3_BUCKET" >/dev/null
garage bucket allow --read --write --owner "$NAVIGATOR_S3_BUCKET" --key "$NAVIGATOR_S3_ACCESS_KEY_ID" >/dev/null
echo "garage ready: bucket $NAVIGATOR_S3_BUCKET"
