# Navigator configuration. Copy to a private env file (never commit real values).
# Local development: scripts/dev-up generates .dev/navigator.env for you.
# Production: see docs/SETUP.md.

NAVIGATOR_ENV=prod                       # dev | test | prod
NAVIGATOR_PUBLIC_URL=https://navigator.example.com
NAVIGATOR_LOG_LEVEL=info

# Postgres: runtime role (row-level security applies) and the schema owner (migrations)
NAVIGATOR_DATABASE_URL=postgresql+psycopg://navigator_app:CHANGE_ME@navigator-db:5432/navigator
NAVIGATOR_MIGRATE_DATABASE_URL=postgresql+psycopg://navigator_owner:CHANGE_ME@navigator-db:5432/navigator
# used once by deploy/initdb when the database volume is first created
POSTGRES_PASSWORD=CHANGE_ME
NAVIGATOR_DB_OWNER_PASSWORD=CHANGE_ME
NAVIGATOR_DB_APP_PASSWORD=CHANGE_ME

# S3-compatible media store (Garage on the server; any S3 such as Backblaze B2 later)
NAVIGATOR_S3_ENDPOINT=http://navigator-storage:3900
NAVIGATOR_S3_PUBLIC_ENDPOINT=https://files.navigator.example.com
NAVIGATOR_S3_REGION=garage
NAVIGATOR_S3_BUCKET=navigator-media
NAVIGATOR_S3_ACCESS_KEY_ID=CHANGE_ME
NAVIGATOR_S3_SECRET_ACCESS_KEY=CHANGE_ME
GARAGE_RPC_SECRET=CHANGE_ME
GARAGE_ADMIN_TOKEN=CHANGE_ME

# WorkOS AuthKit (from M1): use the staging environment locally, production on the server
WORKOS_API_KEY=CHANGE_ME
WORKOS_CLIENT_ID=CHANGE_ME
